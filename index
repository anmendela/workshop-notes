<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anastasiia Mendela — Delivery Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ─── RESET & BASE ─────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    :root {
      --sky-50:  #f0f9ff;
      --sky-100: #e0f2fe;
      --sky-200: #bae6fd;
      --sky-300: #7dd3fc;
      --sky-400: #38bdf8;
      --sky-500: #0ea5e9;
      --sky-600: #0284c7;
      --sky-700: #0369a1;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --white: #ffffff;
      --radius: 16px;
      --shadow-sm: 0 2px 12px rgba(14,165,233,.08);
      --shadow-md: 0 8px 32px rgba(14,165,233,.14);
      --shadow-lg: 0 20px 60px rgba(14,165,233,.18);
      --transition: all .35s cubic-bezier(.4,0,.2,1);
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--sky-50);
      color: var(--slate-700);
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* ─── SCROLLBAR ─────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--sky-50); }
    ::-webkit-scrollbar-thumb { background: var(--sky-300); border-radius: 99px; }

    /* ─── NAVIGATION ────────────────────────────────────── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; justify-content: center;
      padding: 18px 24px;
      backdrop-filter: blur(18px);
      background: rgba(240,249,255,.82);
      border-bottom: 1px solid rgba(186,230,253,.5);
      transition: var(--transition);
    }
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; max-width: 1100px;
    }
    .nav-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem; font-weight: 600;
      color: var(--sky-600); text-decoration: none;
      letter-spacing: .02em;
    }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      font-size: .875rem; font-weight: 500;
      color: var(--slate-600); text-decoration: none;
      position: relative; padding-bottom: 2px;
      transition: color .25s;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -2px; left: 0;
      width: 0; height: 2px;
      background: var(--sky-400);
      border-radius: 2px;
      transition: width .3s ease;
    }
    .nav-links a:hover { color: var(--sky-600); }
    .nav-links a:hover::after { width: 100%; }
    .nav-toggle { display: none; cursor: pointer; flex-direction: column; gap: 5px; }
    .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--sky-600); border-radius: 2px; transition: var(--transition); }

    /* ─── HERO ──────────────────────────────────────────── */
    #hero {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 120px 24px 80px;
      position: relative;
      background:
        radial-gradient(ellipse 70% 50% at 80% 20%, rgba(186,230,253,.55) 0%, transparent 60%),
        radial-gradient(ellipse 50% 60% at 10% 80%, rgba(224,242,254,.7) 0%, transparent 55%),
        linear-gradient(160deg, #f0f9ff 0%, #e0f2fe 45%, #f0f9ff 100%);
      overflow: hidden;
    }
    .hero-bubbles {
      position: absolute; inset: 0; pointer-events: none; overflow: hidden;
    }
    .bubble {
      position: absolute; border-radius: 50%;
      background: radial-gradient(circle, rgba(186,230,253,.45), rgba(224,242,254,.1));
      animation: float linear infinite;
    }
    @keyframes float {
      0%   { transform: translateY(0) scale(1);   opacity: .6; }
      50%  { transform: translateY(-40px) scale(1.05); opacity: .9; }
      100% { transform: translateY(0) scale(1);   opacity: .6; }
    }
    .hero-content {
      text-align: center; max-width: 780px;
      position: relative; z-index: 1;
    }
    .hero-badge {
      display: inline-block;
      background: rgba(186,230,253,.55);
      color: var(--sky-700);
      border: 1px solid rgba(125,211,252,.6);
      border-radius: 99px;
      padding: 6px 20px;
      font-size: .8rem; font-weight: 600;
      letter-spacing: .08em; text-transform: uppercase;
      margin-bottom: 24px;
      backdrop-filter: blur(8px);
    }
    .hero-name {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.8rem, 6vw, 5rem);
      font-weight: 700;
      color: var(--slate-800);
      line-height: 1.12;
      margin-bottom: 16px;
      letter-spacing: -.01em;
    }
    .hero-name span { color: var(--sky-500); }
    .hero-title {
      font-size: clamp(1rem, 2.5vw, 1.25rem);
      font-weight: 500; color: var(--sky-600);
      margin-bottom: 22px;
      letter-spacing: .02em;
    }
    .hero-tagline {
      font-size: clamp(.9rem, 2vw, 1.05rem);
      color: var(--slate-600);
      max-width: 600px; margin: 0 auto 40px;
      line-height: 1.75;
    }
    .hero-cta {
      display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 30px; border-radius: 99px;
      font-size: .9rem; font-weight: 600;
      text-decoration: none; cursor: pointer; border: none;
      transition: var(--transition);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--sky-500), var(--sky-600));
      color: var(--white);
      box-shadow: 0 4px 20px rgba(14,165,233,.35);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(14,165,233,.45);
    }
    .btn-secondary {
      background: var(--white);
      color: var(--sky-600);
      border: 1.5px solid var(--sky-200);
      box-shadow: var(--shadow-sm);
    }
    .btn-secondary:hover {
      background: var(--sky-50);
      border-color: var(--sky-300);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .hero-scroll {
      position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      color: var(--sky-400); font-size: .75rem; font-weight: 500;
      letter-spacing: .08em; text-transform: uppercase;
      animation: bounce 2.4s ease-in-out infinite;
    }
    .hero-scroll svg { width: 20px; height: 20px; }
    @keyframes bounce { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(8px); } }

    /* ─── SECTIONS COMMON ───────────────────────────────── */
    section { padding: 100px 24px; }
    .section-inner { max-width: 1100px; margin: 0 auto; }
    .section-label {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: .75rem; font-weight: 700;
      color: var(--sky-500); letter-spacing: .12em; text-transform: uppercase;
      margin-bottom: 12px;
    }
    .section-label::before {
      content: ''; display: block;
      width: 24px; height: 2px;
      background: var(--sky-400); border-radius: 2px;
    }
    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 700; color: var(--slate-800);
      margin-bottom: 56px; line-height: 1.2;
    }

    /* ─── ABOUT ─────────────────────────────────────────── */
    #about { background: var(--white); }
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px; align-items: start;
    }
    .about-text p {
      font-size: 1rem; color: var(--slate-600);
      margin-bottom: 18px; line-height: 1.8;
    }
    .about-stats {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
      margin-top: 8px;
    }
    .stat-card {
      background: var(--sky-50);
      border: 1px solid var(--sky-100);
      border-radius: var(--radius);
      padding: 24px 20px;
      text-align: center;
      transition: var(--transition);
    }
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--sky-200);
    }
    .stat-number {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem; font-weight: 700; color: var(--sky-500);
      line-height: 1;
    }
    .stat-desc { font-size: .8rem; color: var(--slate-600); margin-top: 6px; font-weight: 500; }
    .about-right { display: flex; flex-direction: column; gap: 20px; }
    .info-card {
      background: linear-gradient(135deg, var(--sky-50), var(--sky-100));
      border: 1px solid var(--sky-200);
      border-radius: var(--radius);
      padding: 28px;
    }
    .info-card h4 {
      font-size: .75rem; font-weight: 700;
      color: var(--sky-500); letter-spacing: .1em; text-transform: uppercase;
      margin-bottom: 16px;
    }
    .info-row {
      display: flex; align-items: center; gap: 12px;
      margin-bottom: 12px;
    }
    .info-row:last-child { margin-bottom: 0; }
    .info-icon {
      width: 34px; height: 34px; border-radius: 8px;
      background: var(--white);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      box-shadow: var(--shadow-sm);
    }
    .info-icon svg { width: 16px; height: 16px; color: var(--sky-500); }
    .info-row span { font-size: .875rem; color: var(--slate-600); }
    .info-row a { color: var(--sky-600); text-decoration: none; font-weight: 500; }
    .info-row a:hover { text-decoration: underline; }

    /* ─── SKILLS ────────────────────────────────────────── */
    #skills {
      background: linear-gradient(160deg, var(--sky-50) 0%, #e8f4fd 50%, var(--sky-50) 100%);
    }
    .skills-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px;
    }
    .skill-group {
      background: var(--white);
      border: 1px solid var(--sky-100);
      border-radius: var(--radius);
      padding: 28px;
      transition: var(--transition);
    }
    .skill-group:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--sky-200);
    }
    .skill-group-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: linear-gradient(135deg, var(--sky-100), var(--sky-200));
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 16px;
    }
    .skill-group-icon svg { width: 22px; height: 22px; color: var(--sky-600); }
    .skill-group h3 {
      font-size: .9rem; font-weight: 700;
      color: var(--slate-700); margin-bottom: 16px;
      letter-spacing: .02em;
    }
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      display: inline-block;
      padding: 5px 13px;
      border-radius: 99px;
      font-size: .775rem; font-weight: 500;
      background: var(--sky-50);
      border: 1px solid var(--sky-200);
      color: var(--sky-700);
      transition: var(--transition);
    }
    .tag:hover {
      background: var(--sky-100);
      border-color: var(--sky-300);
      transform: translateY(-1px);
    }
    .tag.accent {
      background: linear-gradient(135deg, var(--sky-100), var(--sky-200));
      border-color: var(--sky-300);
      font-weight: 600;
    }

    /* ─── EXPERIENCE ────────────────────────────────────── */
    #experience { background: var(--white); }
    .timeline {
      position: relative;
      padding-left: 36px;
    }
    .timeline::before {
      content: ''; position: absolute;
      left: 6px; top: 8px; bottom: 8px;
      width: 2px;
      background: linear-gradient(to bottom, var(--sky-300), var(--sky-200), transparent);
      border-radius: 2px;
    }
    .timeline-item {
      position: relative; margin-bottom: 56px;
    }
    .timeline-item:last-child { margin-bottom: 0; }
    .timeline-dot {
      position: absolute; left: -36px; top: 6px;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--sky-400);
      border: 3px solid var(--white);
      box-shadow: 0 0 0 3px var(--sky-200);
      transition: var(--transition);
    }
    .timeline-item:hover .timeline-dot {
      background: var(--sky-500);
      box-shadow: 0 0 0 4px var(--sky-200), 0 0 12px rgba(14,165,233,.3);
    }
    .timeline-card {
      background: var(--sky-50);
      border: 1px solid var(--sky-100);
      border-radius: var(--radius);
      padding: 32px;
      transition: var(--transition);
    }
    .timeline-card:hover {
      background: var(--white);
      border-color: var(--sky-200);
      box-shadow: var(--shadow-md);
      transform: translateX(6px);
    }
    .timeline-header {
      display: flex; justify-content: space-between;
      align-items: flex-start; flex-wrap: wrap; gap: 12px;
      margin-bottom: 6px;
    }
    .timeline-company {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem; font-weight: 700;
      color: var(--slate-800);
    }
    .timeline-period {
      display: inline-flex; align-items: center;
      background: var(--sky-100);
      color: var(--sky-700);
      border: 1px solid var(--sky-200);
      border-radius: 99px;
      padding: 4px 14px;
      font-size: .775rem; font-weight: 600;
      white-space: nowrap;
    }
    .timeline-role {
      font-size: .95rem; font-weight: 600;
      color: var(--sky-600); margin-bottom: 16px;
    }
    .timeline-card ul { list-style: none; padding: 0; }
    .timeline-card ul li {
      position: relative; padding-left: 20px;
      font-size: .875rem; color: var(--slate-600);
      margin-bottom: 8px; line-height: 1.65;
    }
    .timeline-card ul li::before {
      content: ''; position: absolute;
      left: 0; top: 9px;
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--sky-400);
    }
    .timeline-badge {
      display: inline-block;
      background: rgba(14,165,233,.1);
      color: var(--sky-600);
      border-radius: 8px;
      padding: 4px 10px;
      font-size: .75rem; font-weight: 600;
      margin-bottom: 14px;
    }

    /* ─── EDUCATION ─────────────────────────────────────── */
    #education {
      background: linear-gradient(160deg, var(--sky-50) 0%, var(--sky-100) 100%);
    }
    .edu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .edu-card {
      background: var(--white);
      border: 1px solid var(--sky-100);
      border-radius: var(--radius);
      padding: 32px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }
    .edu-card::before {
      content: ''; position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--sky-400), var(--sky-300));
    }
    .edu-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--sky-200);
    }
    .edu-icon {
      width: 48px; height: 48px; border-radius: 12px;
      background: linear-gradient(135deg, var(--sky-100), var(--sky-200));
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 18px;
    }
    .edu-icon svg { width: 24px; height: 24px; color: var(--sky-600); }
    .edu-card h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem; font-weight: 700;
      color: var(--slate-800); margin-bottom: 6px;
    }
    .edu-card .edu-sub {
      font-size: .85rem; color: var(--sky-600);
      font-weight: 500; margin-bottom: 10px;
    }
    .edu-card .edu-detail {
      font-size: .825rem; color: var(--slate-600);
    }
    .cert-list { display: flex; flex-direction: column; gap: 14px; }
    .cert-item {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 14px 16px;
      background: var(--sky-50);
      border: 1px solid var(--sky-100);
      border-radius: 10px;
      transition: var(--transition);
    }
    .cert-item:hover {
      background: var(--sky-100);
      border-color: var(--sky-200);
    }
    .cert-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--sky-400); margin-top: 6px; flex-shrink: 0;
    }
    .cert-name { font-size: .875rem; font-weight: 600; color: var(--slate-700); }
    .cert-issuer { font-size: .775rem; color: var(--slate-600); margin-top: 2px; }

    /* ─── LANGUAGES ─────────────────────────────────────── */
    .lang-grid { display: flex; gap: 20px; margin-top: 32px; flex-wrap: wrap; }
    .lang-card {
      flex: 1; min-width: 160px;
      background: var(--white);
      border: 1px solid var(--sky-100);
      border-radius: var(--radius);
      padding: 24px;
      text-align: center;
      transition: var(--transition);
    }
    .lang-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: var(--sky-200);
    }
    .lang-name { font-size: 1rem; font-weight: 700; color: var(--slate-700); margin-bottom: 6px; }
    .lang-level { font-size: .825rem; color: var(--sky-600); font-weight: 500; }
    .lang-bar {
      width: 100%; height: 4px;
      background: var(--sky-100); border-radius: 99px;
      margin-top: 12px; overflow: hidden;
    }
    .lang-bar-fill { height: 100%; background: linear-gradient(90deg, var(--sky-400), var(--sky-500)); border-radius: 99px; transition: width 1.2s ease; }

    /* ─── CONTACT ───────────────────────────────────────── */
    #contact {
      background: linear-gradient(160deg, var(--sky-600) 0%, var(--sky-700) 100%);
      color: var(--white);
    }
    #contact .section-label { color: var(--sky-200); }
    #contact .section-label::before { background: var(--sky-300); }
    #contact .section-title { color: var(--white); }
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .contact-card {
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.2);
      border-radius: var(--radius);
      padding: 28px;
      backdrop-filter: blur(12px);
      transition: var(--transition);
      text-decoration: none; display: block;
    }
    .contact-card:hover {
      background: rgba(255,255,255,.2);
      border-color: rgba(255,255,255,.35);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0,0,0,.15);
    }
    .contact-card-icon {
      width: 48px; height: 48px; border-radius: 12px;
      background: rgba(255,255,255,.2);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 16px;
    }
    .contact-card-icon svg { width: 22px; height: 22px; color: var(--white); }
    .contact-card-label {
      font-size: .7rem; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--sky-200); margin-bottom: 4px;
    }
    .contact-card-value {
      font-size: .95rem; font-weight: 600; color: var(--white);
    }

    /* ─── FOOTER ────────────────────────────────────────── */
    footer {
      background: var(--sky-700);
      color: var(--sky-200);
      text-align: center;
      padding: 28px 24px;
      font-size: .8rem;
    }
    footer a { color: var(--sky-300); text-decoration: none; }
    footer a:hover { color: var(--white); }

    /* ─── REVEAL ANIMATIONS ─────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity .65s cubic-bezier(.4,0,.2,1), transform .65s cubic-bezier(.4,0,.2,1);
    }
    .reveal.visible {
      opacity: 1; transform: translateY(0);
    }
    .reveal-left {
      opacity: 0; transform: translateX(-30px);
      transition: opacity .65s cubic-bezier(.4,0,.2,1), transform .65s cubic-bezier(.4,0,.2,1);
    }
    .reveal-left.visible { opacity: 1; transform: translateX(0); }
    .reveal-right {
      opacity: 0; transform: translateX(30px);
      transition: opacity .65s cubic-bezier(.4,0,.2,1), transform .65s cubic-bezier(.4,0,.2,1);
    }
    .reveal-right.visible { opacity: 1; transform: translateX(0); }

    .delay-1 { transition-delay: .1s; }
    .delay-2 { transition-delay: .2s; }
    .delay-3 { transition-delay: .3s; }
    .delay-4 { transition-delay: .4s; }
    .delay-5 { transition-delay: .5s; }
    .delay-6 { transition-delay: .6s; }

    /* ─── RESPONSIVE ────────────────────────────────────── */
    @media (max-width: 900px) {
      .about-grid { grid-template-columns: 1fr; gap: 40px; }
      .skills-grid { grid-template-columns: 1fr 1fr; }
      .edu-grid { grid-template-columns: 1fr; }
      .contact-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      nav { padding: 14px 18px; }
      .nav-links { display: none; flex-direction: column; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(240,249,255,.97); backdrop-filter: blur(20px); justify-content: center; align-items: center; gap: 2.5rem; z-index: 99; }
      .nav-links.open { display: flex; }
      .nav-links a { font-size: 1.1rem; }
      .nav-toggle { display: flex; z-index: 101; }
      .skills-grid { grid-template-columns: 1fr; }
      .contact-grid { grid-template-columns: 1fr; }
      .about-stats { grid-template-columns: 1fr 1fr; }
      section { padding: 72px 18px; }
      .timeline { padding-left: 28px; }
      .timeline-dot { left: -28px; }
      .timeline-header { flex-direction: column; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
